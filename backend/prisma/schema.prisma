generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CounterStatus {
  OPEN
  PAUSED
  CLOSED
}

enum TokenClass {
  EMERGENCY
  PRIORITY
  APPOINTMENT
  NORMAL
}

enum TokenState {
  WAITING
  CALLED
  SERVING
  DONE
  MISSED
  NO_SHOW
  REDIRECTED
  CANCELLED
}

model Service {
  id          String         @id @default(cuid())
  name        String
  prefix      String         @unique
  icon        String         @default("circle")
  targetWaitS Int
  priorMu     Float // log-mean of service minutes (configured prior)
  priorSigma  Float // log-sd of service minutes (configured prior)
  obsN        Int            @default(0) // online log-duration stats (Welford)
  obsMean     Float          @default(0)
  obsM2       Float          @default(0)
  skills      CounterSkill[]
  tokens      Token[]
}

model Counter {
  id     String         @id @default(cuid())
  name   String
  status CounterStatus  @default(OPEN)
  skills CounterSkill[]
  tokens Token[]
}

model CounterSkill {
  counterId String
  serviceId String
  counter   Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([counterId, serviceId])
}

model Token {
  id              String      @id @default(cuid())
  seq             Int         @default(autoincrement())
  code            String
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  class           TokenClass  @default(NORMAL)
  state           TokenState  @default(WAITING)
  arrivedAt       DateTime    @default(now())
  creditedArrival DateTime    @default(now())
  deadline        DateTime
  notBefore       DateTime    @default(now())
  missCount       Int         @default(0)
  recallCount     Int         @default(0)
  redirectDepth   Int         @default(0)
  promiseP90      DateTime?
  etaP50          DateTime?
  etaP90          DateTime?
  calledAt        DateTime?
  lastCallAt      DateTime?
  servedAt        DateTime?
  doneAt          DateTime?
  pickReason      String?
  counterId       String?
  counter         Counter?    @relation(fields: [counterId], references: [id])
  parentTokenId   String?
  secret          String      @unique // per-token access key from the QR link, base64url(24 random bytes)
  etaChanges      EtaChange[]

  @@index([state, serviceId])
}

model Event {
  seq       Int      @id @default(autoincrement())
  ts        DateTime @default(now())
  type      String
  tokenId   String?
  counterId String?
  payload   Json?
  actor     String?
}

model EtaChange {
  id         Int      @id @default(autoincrement())
  tokenId    String
  token      Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  ts         DateTime @default(now())
  deltaS     Int
  reason     String
  causeEvent Int?
}
