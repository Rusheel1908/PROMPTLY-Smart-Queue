# All variables are validated once at startup (src/config.ts); a bad value stops the server with a list of problems.

# development | test | production. Production requires an Origin on WebSockets, and the seed never generates staff PINs.
NODE_ENV=development

# HTTP + WebSocket port.
PORT=4000

# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/promptly?schema=public"

# Comma-separated list of frontend origins allowed by CORS and by the WebSocket Origin check.
# e.g. CORS_ORIGIN=https://promptly.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Staff log in with their own accounts (npm run db:seed). There is no shared staff PIN any more.
# Seed-time only: PINs for the staff accounts, as JSON name → PIN (at least 6 characters each).
# Required for the seed in production (and always for npm run db:setup, see DEPLOY.md); in dev, leave it unset
# and the seed prints random demo PINs once.
# SEED_STAFF_PINS='{"Asha":"…","Ravi":"…","Meera":"…"}'

# Express "trust proxy": false (direct), a hop count, or a subnet list. Behind Render or Vercel use 1,
# so rate limits see the real client IP. Don't use "true": clients could then spoof X-Forwarded-For.
TRUST_PROXY=false

# API tests (npm run test:api) use their own database; the name must end in _test
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/promptly_test?schema=public"
